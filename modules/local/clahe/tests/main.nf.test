// test with: nf-core modules test molkartgarage/clahe
nextflow_process {

    name "Test Process CLAHE"
    script "../main.nf"
    process "CLAHE"

    tag "modules"
    tag "modules_local"
    tag "clahe"

    test("clahe - tiff") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'imaging/tiff/mindagap.mouse_heart.wga.tiff', checkIfExists: true)
                    ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    file(process.out.img_clahe.get(0).get(1)).exists(),
                    file(process.out.img_clahe.get(0).get(1)).size(),
                )}
            )
        }

    }

    test("clahe - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'imaging/tiff/mindagap.mouse_heart.wga.tiff', checkIfExists: true)
                    ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success }
            )
        }

    }

}
