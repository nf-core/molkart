nextflow_pipeline {

    name "Test Workflow main.nf"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_molkart"

    test("Nuclear channel, stardist, mesmer and cellpose, without clahe") {

        when {
            params {
                input = 'https://raw.githubusercontent.com/nf-core/test-datasets/molkart/test_data/samplesheets/samplesheet_nuclear.csv'
                outdir = "$outputDir"
                skip_clahe = true
                mindagap_tilesize = 90
                mindagap_boxsize = 7
                mindagap_loopnum = 100
                segmentation_method = "cellpose,mesmer,stardist"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // cellpose 4.x (cellpose-SAM) is not bit-reproducible across CPU models, so its mask
            // and everything derived from it is left out of stable_path (see tests/.nftignore)
            // and checked here instead: the outputs have to exist and be non-empty.
            def cellpose_files = [
                "segmentation/cellpose/nuc_only_cellpose_mask.tif",
                "segmentation/filtered_masks/nuc_only_cellpose_filtered.tif",
                "segmentation/filtered_masks/nuc_only_cellpose_filtered.csv",
                "molkartqc/nuc_only.cellpose.spot_QC.csv"
            ].collect { file("$outputDir/$it") }
            // Of the segmentation stats, keep the columns that come from the spot table rather
            // than from the mask: sample, method, total_spots and duplicated_total
            def segmentation_stats = path("$outputDir/multiqc/multiqc_data/multiqc_segmentation_stats.txt")
                .readLines()
                .collect { line -> def col = line.split('\t'); [col[0], col[1], col[4], col[8]].join('\t') }
            assert workflow.success
            assertAll(
                { assert workflow.success},
                { assert cellpose_files.every { it.exists() && it.size() > 0 } },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we tests pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_molkart_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path,
                    // Mask-independent columns of the segmentation stats
                    segmentation_stats
                ).match() }
            )
        }
    }

    test("Two channels, mesmer and cellpose, with clahe") {

        when {
            params {
                input = 'https://raw.githubusercontent.com/nf-core/test-datasets/molkart/test_data/samplesheets/samplesheet_membrane.csv'
