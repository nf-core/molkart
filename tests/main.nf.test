    test("Skip mindagap - skip clahe - extended spots - stardist") {

        when {
            params {
                input = 'https://raw.githubusercontent.com/nf-core/test-datasets/molkart/test_data/samplesheets/samplesheet_extended_spots.csv'
                outdir = "$outputDir"
                skip_clahe = true
                skip_mindagap = true
                segmentation_method = "stardist"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // The segmentation stats are ignored in stable_path because cellpose contributes an
            // unstable row to them (see tests/.nftignore). Nothing here runs cellpose, so the
            // whole file is stable and is snapshotted in full.
            def segmentation_stats = path("$outputDir/multiqc/multiqc_data/multiqc_segmentation_stats.txt").readLines()
            assert workflow.success
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we tests pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_molkart_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path,
                    // Full segmentation stats, stable in the absence of cellpose
                    segmentation_stats
                ).match() }
            )
        }
    }

    test("Create training subset") {

        when {
            params {
                input = 'https://raw.githubusercontent.com/nf-core/test-datasets/molkart/test_data/samplesheets/samplesheet_nuclear.csv'
                outdir = "$outputDir"
                mindagap_tilesize = 90
                mindagap_boxsize = 7
                mindagap_loopnum = 100
                clahe_pyramid_tile = 368
                create_training_subset = true
                crop_amount = 2
                crop_size_x = 10
                crop_size_y = 10
                }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we tests pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_molkart_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }

